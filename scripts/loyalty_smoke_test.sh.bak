#!/usr/bin/env bash
# =============================================================================
# Arusuvai Junction - Loyalty Points End-to-End Smoke Test
# =============================================================================
# Exercises the full admin -> client loyalty lifecycle against a running backend:
#
#   AUTH      login user + admin  ->  refresh-token  ->  access-token
#   ADMIN     set point economics (point_value_inr)
#   EARN      user QR scan (PENDING)  ->  admin approve (+points)
#   EARN      verify card balance credited
#   SPEND     online redeem quote (clamp preview)
#   SPEND     offline redeem request (reserve/deduct, PENDING)
#   ADMIN     reject offline redemption  -> points REFUNDED  (asserts refund)
#   SPEND     offline redeem request again -> admin APPROVE (points kept)
#   VERIFY    final balance math is internally consistent
#
# Everything is asserted; the script exits non-zero on the first failure.
#
# USAGE
#   ./scripts/loyalty_smoke_test.sh
#        (prompts interactively for user + admin credentials)
#
#   BASE_URL=http://localhost:8080/arusuvai \
#   USER_EMAIL=... USER_PASS=... ADMIN_EMAIL=... ADMIN_PASS=... \
#     ./scripts/loyalty_smoke_test.sh        (fully non-interactive / CI)
#
# REQUIREMENTS: bash, curl, jq
# =============================================================================
set -uo pipefail

# ---- config -----------------------------------------------------------------
BASE_URL="${BASE_URL:-http://localhost:8080/arusuvai}"
# Point value used during the test (rupees per 1 point). Restored at the end.
TEST_POINT_VALUE="${TEST_POINT_VALUE:-10}"
# Rupee order total used for the online redeem quote preview.
QUOTE_ORDER_TOTAL="${QUOTE_ORDER_TOTAL:-500}"
# Points the user attempts to redeem offline.
OFFLINE_POINTS="${OFFLINE_POINTS:-1}"

# ---- pretty output ----------------------------------------------------------
RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; BLUE=$'\033[0;34m'; DIM=$'\033[2m'; NC=$'\033[0m'
PASS_N=0; FAIL_N=0
step()  { printf "\n${BLUE}==>${NC} ${1}\n"; }
info()  { printf "    ${DIM}%s${NC}\n" "$1"; }
ok()    { PASS_N=$((PASS_N+1)); printf "    ${GREEN}PASS${NC} %s\n" "$1"; }
die()   { FAIL_N=$((FAIL_N+1)); printf "    ${RED}FAIL${NC} %s\n" "$1"; summary; exit 1; }
assert(){ if eval "$1"; then ok "$2"; else die "$2  ${DIM}(assert failed: $1)${NC}"; fi; }

summary() {
  printf "\n${BLUE}========================================${NC}\n"
  printf "  Passed: ${GREEN}%s${NC}   Failed: ${RED}%s${NC}\n" "$PASS_N" "$FAIL_N"
  printf "${BLUE}========================================${NC}\n"
}

need() { command -v "$1" >/dev/null 2>&1 || { echo "Missing dependency: $1"; exit 2; }; }
need curl; need jq

# ---- credentials (prompt if not supplied via env) ---------------------------
prompt_secret() { # $1=varname $2=label
  local v; printf "    %s: " "$2" >&2; read -r -s v; printf "\n" >&2; printf '%s' "$v"
}
prompt_plain()  { local v; printf "    %s: " "$2" >&2; read -r v; printf '%s' "$v"; }

step "Credentials"
info "Base URL: ${BASE_URL}"
USER_EMAIL="${USER_EMAIL:-$(prompt_plain  USER_EMAIL 'Customer email')}"
USER_PASS="${USER_PASS:-$(prompt_secret   USER_PASS  'Customer password')}"
ADMIN_EMAIL="${ADMIN_EMAIL:-$(prompt_plain ADMIN_EMAIL 'Admin email')}"
ADMIN_PASS="${ADMIN_PASS:-$(prompt_secret  ADMIN_PASS  'Admin password')}"
[ -n "$USER_EMAIL" ]  || die "customer email required"
[ -n "$ADMIN_EMAIL" ] || die "admin email required"

# ---- http helpers -----------------------------------------------------------
# All responses follow { success, message, data, statusCode }.
# req METHOD PATH [BEARER] [JSON_BODY]  -> echoes raw JSON body, sets HTTP_CODE.
#
# NOTE: req is normally called inside $(...) command substitution, which runs
# in a SUBSHELL on bash 3.2 (macOS default) -> a plain variable assignment
# would NOT propagate to the caller. We therefore persist the HTTP status to a
# temp file and have the caller read it back via the HTTP_CODE global.
HTTP_CODE=""
_CODE_FILE="$(mktemp)"
trap 'rm -f "$_CODE_FILE"' EXIT
req() {
  local method="$1" path="$2" bearer="${3:-}" body="${4:-}"
  local url="${BASE_URL}${path}" tmp; tmp="$(mktemp)"
  local -a args=(-sS -X "$method" -o "$tmp" -w '%{http_code}')
  [ -n "$bearer" ] && args+=(-H "Authorization: Bearer ${bearer}")
  if [ -n "$body" ]; then args+=(-H "Content-Type: application/json" --data "$body"); fi
  curl "${args[@]}" "$url" > "$_CODE_FILE" 2>/dev/null
  cat "$tmp"; rm -f "$tmp"
}
# Call immediately AFTER a req "$(...)" capture to refresh the HTTP_CODE global
# in the current (parent) shell from the status the subshell wrote to disk.
sync_code() { HTTP_CODE="$(cat "$_CODE_FILE" 2>/dev/null)"; }
jq_get()  { echo "$1" | jq -r "$2" 2>/dev/null; }
is_ok()   { [ "$(jq_get "$1" '.success')" = "true" ]; }

# =============================================================================
# 0. Health
# =============================================================================
step "0. Health check"
H="$(req GET /health)"; sync_code
assert '[ "$HTTP_CODE" = "200" ]' "backend reachable at ${BASE_URL} (HTTP ${HTTP_CODE})"

# =============================================================================
# 1. AUTH - login, then prove refresh-token -> access-token works
# =============================================================================
login() { # $1=email $2=pass  -> echoes "<access>|<refresh>"
  local resp; resp="$(req POST '/auth?isLogin=true' '' \
      "$(jq -nc --arg e "$1" --arg p "$2" '{email:$e, passwordHash:$p}')")"
  is_ok "$resp" || { echo "LOGINFAIL:$(jq_get "$resp" '.message')"; return 1; }
  printf '%s|%s' "$(jq_get "$resp" '.data.accessToken')" "$(jq_get "$resp" '.data.refreshToken')"
}

step "1. Authenticate customer + admin"
U_PAIR="$(login "$USER_EMAIL" "$USER_PASS")"   || die "customer login failed: ${U_PAIR#LOGINFAIL:}"
A_PAIR="$(login "$ADMIN_EMAIL" "$ADMIN_PASS")"  || die "admin login failed: ${A_PAIR#LOGINFAIL:}"
USER_REFRESH="${U_PAIR#*|}"
ADMIN_REFRESH="${A_PAIR#*|}"
assert '[ -n "$USER_REFRESH" ] && [ "$USER_REFRESH" != "null" ]'  "customer login issued a refresh token"
assert '[ -n "$ADMIN_REFRESH" ] && [ "$ADMIN_REFRESH" != "null" ]' "admin login issued a refresh token"

# Exchange refresh -> fresh access token (the flow you asked to exercise).
refresh_access() { # $1=refreshToken -> echoes access token
  local resp; resp="$(req POST '/auth?isRefresh=1' '' \
      "$(jq -nc --arg t "$1" '{token:$t}')")"
  is_ok "$resp" || { echo ""; return 1; }
  jq_get "$resp" '.data.accessToken'
}
step "1b. Refresh token -> access token exchange"
USER_TOKEN="$(refresh_access "$USER_REFRESH")"
ADMIN_TOKEN="$(refresh_access "$ADMIN_REFRESH")"
assert '[ -n "$USER_TOKEN" ]  && [ "$USER_TOKEN" != "null" ]'  "customer access token obtained via refresh"
assert '[ -n "$ADMIN_TOKEN" ] && [ "$ADMIN_TOKEN" != "null" ]' "admin access token obtained via refresh"

# Confirm the admin token actually carries admin authority (admin-only endpoint).
GUARD="$(req GET '/api/admin/loyalty?limit=1' "$USER_TOKEN")"; sync_code
assert '[ "$HTTP_CODE" = "403" ] || [ "$(jq_get "$GUARD" .success)" = "false" ]' \
       "customer token is correctly REJECTED on admin endpoint (HTTP ${HTTP_CODE})"
GUARD="$(req GET '/api/admin/loyalty?limit=1' "$ADMIN_TOKEN")"
assert 'is_ok "$GUARD"' "admin token is ACCEPTED on admin endpoint"

# =============================================================================
# 2. ADMIN - set point economics, then confirm it's readable
# =============================================================================
step "2. Admin sets point value (point_value_inr=${TEST_POINT_VALUE})"
SET="$(req GET '/api/admin/loyalty/redemptions/settings' "$ADMIN_TOKEN")"
ORIG_PV="$(jq_get "$SET" '.data.pointValueInr')"
info "current point value: ${ORIG_PV}"
PUT="$(req PUT '/api/admin/loyalty/redemptions/settings' "$ADMIN_TOKEN" \
      "$(jq -nc --argjson v "$TEST_POINT_VALUE" '{pointValueInr:$v}')")"
assert 'is_ok "$PUT"' "admin updated point value"
SET="$(req GET '/api/admin/loyalty/redemptions/settings' "$ADMIN_TOKEN")"
assert '[ "$(jq_get "$SET" .data.pointValueInr)" = "${TEST_POINT_VALUE}" ]' \
       "point value now reads back as ${TEST_POINT_VALUE}"

# =============================================================================
# 3. EARN - customer QR scan -> admin approval -> points credited
# =============================================================================
step "3. Customer card snapshot (before earning)"
CARD="$(req GET '/api/loyalty/card' "$USER_TOKEN")"
assert 'is_ok "$CARD"' "customer card fetched"
BAL_BEFORE="$(jq_get "$CARD" '.data.card.points')"; BAL_BEFORE="${BAL_BEFORE:-0}"
info "starting balance: ${BAL_BEFORE} points"

step "3a. Customer QR check-in (POST /api/loyalty/scan)"
SCAN="$(req POST '/api/loyalty/scan' "$USER_TOKEN")"
assert 'is_ok "$SCAN"' "scan accepted"
ALREADY="$(jq_get "$SCAN" '.data.alreadyCheckedIn')"
info "alreadyCheckedIn today: ${ALREADY}"

# Find today's PENDING check-in for this customer in the admin queue.
PENDING_LIST="$(req GET '/api/admin/loyalty?status=PENDING&limit=50' "$ADMIN_TOKEN")"
assert 'is_ok "$PENDING_LIST"' "admin listed PENDING check-ins"
# Match on the user's own card: fetch the card id from the customer's card.
CARD_ID="$(jq_get "$CARD" '.data.card.cardId')"
CHECKIN_ID="$(echo "$PENDING_LIST" | jq -r --arg c "$CARD_ID" \
   '[.data.checkins[]? | select(.cardId==$c)] | sort_by(.createdAt) | last | .checkinId' 2>/dev/null)"

APPROVE_SPEND="${APPROVE_SPEND:-100}"   # in-store rupee spend used to award points
if [ -n "$CHECKIN_ID" ] && [ "$CHECKIN_ID" != "null" ]; then
  step "3b. Admin approves the check-in (purchaseAmount=${APPROVE_SPEND})"
  APP="$(req PATCH "/api/admin/loyalty?checkinId=${CHECKIN_ID}&action=approve&purchaseAmount=${APPROVE_SPEND}" "$ADMIN_TOKEN")"
  assert 'is_ok "$APP"' "check-in approved"
  EARNED="$(jq_get "$APP" '.data.checkin.pointsAwarded')"
  info "points awarded on approval: ${EARNED:-?}"
else
  info "no fresh PENDING check-in (already checked in earlier today) - skipping approval"
  EARNED="0"
fi

step "3c. Verify balance increased after earning"
CARD2="$(req GET '/api/loyalty/card' "$USER_TOKEN")"
BAL_AFTER_EARN="$(jq_get "$CARD2" '.data.card.points')"; BAL_AFTER_EARN="${BAL_AFTER_EARN:-0}"
info "balance after earning: ${BAL_AFTER_EARN} points"
assert '[ "$BAL_AFTER_EARN" -ge "$BAL_BEFORE" ]' "balance did not decrease after a check-in"

# =============================================================================
# 4. SPEND (online) - server-authoritative redeem quote / clamp preview
# =============================================================================
step "4. Online redeem quote (clamp preview, total=${QUOTE_ORDER_TOTAL})"
QUOTE="$(req GET "/api/loyalty/redeem/quote?points=${BAL_AFTER_EARN}&total=${QUOTE_ORDER_TOTAL}" "$USER_TOKEN")"
assert 'is_ok "$QUOTE"' "quote returned"
Q_POINTS="$(jq_get "$QUOTE" '.data.pointsToUse')"
Q_DISCOUNT="$(jq_get "$QUOTE" '.data.discount')"
Q_PAYABLE="$(jq_get "$QUOTE" '.data.payable')"
info "pointsToUse=${Q_POINTS}  discount=${Q_DISCOUNT}  payable=${Q_PAYABLE}"
# Clamp invariant: can never spend more points than the balance.
assert '[ "$Q_POINTS" -le "$BAL_AFTER_EARN" ]' "quote clamps points to available balance"

# =============================================================================
# 5. SPEND (offline) - reserve/deduct, then admin REJECT -> refund
# =============================================================================
if [ "$BAL_AFTER_EARN" -ge "$OFFLINE_POINTS" ]; then
  step "5. Offline redeem #1 -> admin REJECT -> expect REFUND"
  REQ1="$(req POST '/api/loyalty/redeem/offline' "$USER_TOKEN" \
        "$(jq -nc --argjson p "$OFFLINE_POINTS" '{points:$p, note:"smoke-test reject"}')")"
  assert 'is_ok "$REQ1"' "offline redemption #1 created (points reserved)"

  CARD3="$(req GET '/api/loyalty/card' "$USER_TOKEN")"
  BAL_RESERVED="$(jq_get "$CARD3" '.data.card.points')"
  info "balance after reservation: ${BAL_RESERVED} (was ${BAL_AFTER_EARN})"
  assert '[ "$BAL_RESERVED" -eq $(( BAL_AFTER_EARN - OFFLINE_POINTS )) ]' \
         "points were deducted on reservation"

  RED_LIST="$(req GET '/api/admin/loyalty/redemptions?status=PENDING&limit=50' "$ADMIN_TOKEN")"
  RID="$(echo "$RED_LIST" | jq -r --arg c "$CARD_ID" \
     '[.data.redemptions[]? | select(.cardId==$c and .channel=="OFFLINE")] | sort_by(.createdAt) | last | .redemptionId')"
  assert '[ -n "$RID" ] && [ "$RID" != "null" ]' "admin found the PENDING offline redemption"

  REJ="$(req PATCH "/api/admin/loyalty/redemptions?redemptionId=${RID}&action=reject&note=smoke-reject" "$ADMIN_TOKEN")"
  assert 'is_ok "$REJ"' "admin rejected the redemption"

  CARD4="$(req GET '/api/loyalty/card' "$USER_TOKEN")"
  BAL_REFUND="$(jq_get "$CARD4" '.data.card.points')"
  info "balance after rejection: ${BAL_REFUND}"
  assert '[ "$BAL_REFUND" -eq "$BAL_AFTER_EARN" ]' "rejected redemption REFUNDED points to the card"

  # =========================================================================
  # 6. SPEND (offline) - reserve, then admin APPROVE -> points kept
  # =========================================================================
  step "6. Offline redeem #2 -> admin APPROVE -> points kept"
  REQ2="$(req POST '/api/loyalty/redeem/offline' "$USER_TOKEN" \
        "$(jq -nc --argjson p "$OFFLINE_POINTS" '{points:$p, note:"smoke-test approve"}')")"
  assert 'is_ok "$REQ2"' "offline redemption #2 created"

  RED_LIST2="$(req GET '/api/admin/loyalty/redemptions?status=PENDING&limit=50' "$ADMIN_TOKEN")"
  RID2="$(echo "$RED_LIST2" | jq -r --arg c "$CARD_ID" \
     '[.data.redemptions[]? | select(.cardId==$c and .channel=="OFFLINE")] | sort_by(.createdAt) | last | .redemptionId')"
  APPR="$(req PATCH "/api/admin/loyalty/redemptions?redemptionId=${RID2}&action=approve&note=smoke-approve" "$ADMIN_TOKEN")"
  assert 'is_ok "$APPR"' "admin approved the redemption"

  CARD5="$(req GET '/api/loyalty/card' "$USER_TOKEN")"
  BAL_FINAL="$(jq_get "$CARD5" '.data.card.points')"
  info "final balance: ${BAL_FINAL}"
  assert '[ "$BAL_FINAL" -eq $(( BAL_AFTER_EARN - OFFLINE_POINTS )) ]' \
         "approved redemption KEPT points deducted (no refund)"
else
  step "5-6. Offline redeem flow SKIPPED"
  info "balance ${BAL_AFTER_EARN} < OFFLINE_POINTS ${OFFLINE_POINTS}; nothing to redeem."
fi

# =============================================================================
# 7. Cleanup - restore original point value
# =============================================================================
step "7. Restore original point value (${ORIG_PV})"
if [ -n "$ORIG_PV" ] && [ "$ORIG_PV" != "null" ]; then
  REST="$(req PUT '/api/admin/loyalty/redemptions/settings' "$ADMIN_TOKEN" \
        "$(jq -nc --argjson v "$ORIG_PV" '{pointValueInr:$v}')")"
  assert 'is_ok "$REST"' "point value restored to ${ORIG_PV}"
fi

summary
[ "$FAIL_N" -eq 0 ] && { printf "${GREEN}ALL LOYALTY SMOKE TESTS PASSED${NC}\n"; exit 0; } || exit 1
