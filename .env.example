# ─── DB (Neon Postgres) ───────────────────────────────────────────
DB_URL=jdbc:postgresql://YOUR-NEON-HOST.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=replace-me

# ─── App URLs ─────────────────────────────────────────────────────
# Public origin of the backend (used in outgoing email links).
APP_BASE_URL=http://localhost:8080/arusuvai
# Where "Go to homepage" buttons in transactional emails point.
APP_HOME_URL=https://www.arusuvaijunction.com
# Optional: HTTP port (Render injects PORT automatically).
# PORT=8080
# CONTEXT_PATH=/arusuvai

# ─── Razorpay (Standard Checkout) ─────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=replace-me
# Set after creating the webhook in Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# ─── Mail (Zoho SMTP) ─────────────────────────────────────────────
MAIL_ENABLED=true
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USERNAME=noreply@yourdomain.com
SMTP_PASSWORD=app-password-here
SMTP_FROM=Arusuvai Junction <no-reply@yourdomain.com>

# --- ZeptoMail HTTP API (use this on hosts that block SMTP, e.g. Render) ---
# When ZEPTOMAIL_TOKEN is set the SMTP_* config above is ignored.
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_URL=https://api.zeptomail.in/v1.1/email

# ─── Storage (Cloudflare R2 / S3 / local) ─────────────────────────
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=products
R2_PUBLIC_BASE_URL=https://your-r2-public-url.r2.dev

# ─── Web Push (VAPID) ─────────────────────────────────────────────
# EC P-256 key pair (base64url). Generate once; the PUBLIC key is also
# handed to the browser via GET /api/push/vapidPublicKey. Keep the
# PRIVATE key secret. VAPID_SUBJECT is a contact the push service can
# reach if your notifications misbehave (mailto: or https URL).
VAPID_PUBLIC_KEY=BGFWVT9JhqOTqvOBymuztuKcEP7LciJVnu-lf-xsZ5HpHiDOiwf5LaBnJk6FpyIBWnuY6M6TNbRXh5CLhxSM5Go
VAPID_PRIVATE_KEY=eA1Oy-m8gvqPL2az630565eLGAo-FdjTlrT_9SBEYgk
VAPID_SUBJECT=mailto:admin@arusuvaijunction.com
